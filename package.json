{
  "name": "dsh-increasing-my-english",
  "version": "0.1.1",
  "type": "module",
  "description": "English intensive reading for DSH: speaker-diarized podcast transcripts, Ctrl word lookup, a wordbook with phonetics, meanings, word forms and etymology that fills in a word's other senses from every transcript while idle, and a spaced-review mode with daily rounds.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "english",
    "reading",
    "vocabulary",
    "podcast",
    "transcript",
    "srs",
    "review"
  ],
  "license": "MIT",
  "author": "LeeKai233 <leslie.ttpan@gmail.com>",
  "homepage": "https://github.com/LeeKai233/dsh-increasing-my-english#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeKai233/dsh-increasing-my-english.git"
  },
  "bugs": {
    "url": "https://github.com/LeeKai233/dsh-increasing-my-english/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --test",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
